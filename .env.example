NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ligimed
DB_POOL_SIZE=10

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRE=30d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5000,http://localhost:3000,http://localhost:5173

STORAGE_TYPE=local
STORAGE_BUCKET=ligimed-files
STORAGE_KEY=mock
STORAGE_SECRET=mock

KYC_PROVIDER=sandbox
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=your_sandbox_api_key
SANDBOX_API_SECRET=your_sandbox_api_secret
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_key_id
RAZORPAY_KEY_SECRET=razorpay_secret_key
NOTIFICATION_PROVIDER=smtp
SMS_API_KEY=mock
WHATSAPP_API_KEY=mock
EMAIL_API_KEY=mock
AI_API_KEY=mock

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="LigiMed B2B Logistics" <your_email@gmail.com>

LOG_LEVEL=debug
LOG_FILE=./logs/app.log

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000
